            m_registry.emplace<ItemMarketCategoryComponent>(medkit, ItemMarketCategory::MEDICAL);
            m_registry.emplace<ItemMaterialComponent>(medkit, RawMaterialType::CHEMICAL);
            inv.contained_items.push_back(medkit);
