        {
            JSON_THROW(detail::out_of_range::create(410, detail::concat("array index ", s, " exceeds size_type"), nullptr));   // LCOV_EXCL_LINE
        }
        return static_cast<size_type>(res);
    }
  JSON_PRIVATE_UNLESS_TESTED:
    json_pointer top() const
