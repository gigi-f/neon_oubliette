            ncplane_putstr_yx(m_inspection_plane, start_y++, x, "     <><><>      ");
            ncplane_putstr_yx(m_inspection_plane, start_y++, x, "    <  !!  >     ");
            ncplane_putstr_yx(m_inspection_plane, start_y++, x, "     < VV >      ");
            ncplane_putstr_yx(m_inspection_plane, start_y++, x, "    <      >     ");
            ncplane_putstr_yx(m_inspection_plane, start_y++, x, "     <><><>      ");
