    using allocator_type = alloc_traits::allocator_type;
    allocator_type alloc{allocator};
    auto ptr = alloc_traits::allocate(alloc, 1u);
    ENTT_TRY {
        alloc_traits::construct(alloc, stl::to_address(ptr), std::forward<Args>(args)...);
