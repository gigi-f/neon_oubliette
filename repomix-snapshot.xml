    bool operator==(const PositionComponent& other) const {
        return x == other.x && y == other.y && layer_id == other.layer_id;
    }
    bool operator<(const PositionComponent& other) const {
        if (layer_id != other.layer_id) return layer_id < other.layer_id;
        if (x != other.x) return x < other.x;
        return y < other.y;
